# Backend Environment Configuration
APP_NAME="CampusEase ERP API"
APP_VERSION="1.0.0"
DEBUG=True
PORT=8000

# PostgreSQL Database Configuration
DATABASE_URL="postgresql+psycopg2://postgres:password@localhost:5432/campus_erp"
ASYNC_DATABASE_URL="postgresql+asyncpg://postgres:password@localhost:5432/campus_erp"

# JWT Authentication
SECRET_KEY="replace_with_a_secure_random_secret_key"

# AI Core (Google Gemini)
GEMINI_API_KEY="your_google_gemini_api_key"
